<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" protocolVersion="3" />
    <add key="silksong-modding" value="https://git.silksong-modding.org/api/packages/silksong-modding/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Silksong.* is listed under both nuget.org (older versions) and the forge (new versions);
         the most specific pattern wins, so without it here the forge would get no packages. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Silksong.*" />
    </packageSource>
    <packageSource key="silksong-modding">
      <package pattern="Silksong.*" />
    </packageSource>
    <packageSource key="BepInEx">
      <package pattern="BepInEx.*" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
  </packageSourceMapping>
</configuration>
